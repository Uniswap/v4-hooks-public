# UniswapX (Dutch orders)
# Address of the deployed UniswapX Dutch order reactor to fill against, and the canonical WETH9.
# A fork test also needs a pre-signed order: UniswapX orders are signed off-chain via Permit2, and the
# encoding libraries (DutchOrderLib + Permit2 witness) are not vendored in this repo (briefcase is
# interfaces-only). Provide the ABI-encoded SignedOrder bytes (and its token pair/amounts) to drive a fork test.
UNISWAPX_DUTCH_REACTOR_1=
WETH9_1=
# LitePSM (Ethereum mainnet fork, chain 1)
LITE_PSM_WRAPPER=
USDS=

